        "# ==========================================\n",
        "# AI Resume Screening & Job Matching System\n",
        "# PART 7: FINAL RESUME PREDICTION SYSTEM\n",
        "# ==========================================\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "\n",
        "def resume_screening(resume_text):\n",
        "\n",
        "    # Clean resume text\n",
        "    cleaned_text = clean_resume(resume_text)\n",
        "\n",
        "    # Convert text using trained TF-IDF\n",
        "    resume_vector = tfidf.transform([cleaned_text])\n",
        "\n",
        "    # Predict job category\n",
        "    prediction = model.predict(resume_vector)\n",
        "\n",
        "    # Calculate matching score\n",
        "    probability = model.predict_proba(resume_vector)\n",
        "\n",
        "    score = np.max(probability) * 100\n",
        "\n",
        "\n",
        "    print(\"================================\")\n",
        "    print(\" AI Resume Screening Result \")\n",
        "    print(\"================================\")\n",
        "\n",
        "    print(\"Recommended Job Role :\", prediction[0])\n",
        "    print(\"Matching Score       :\", round(score,2), \"%\")\n",
        "\n",
        "\n",
        "# Test Resume\n",
        "\n",
        "candidate_resume = \"\"\"\n",
        "Python Machine Learning\n",
        "Deep Learning TensorFlow\n",
        "SQL Data Analysis\n",
        "Artificial Intelligence Projects\n",
        "\"\"\"\n",
        "\n",
        "resume_screening(candidate_resume)"
