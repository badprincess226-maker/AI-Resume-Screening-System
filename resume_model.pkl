    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "\n",
        "# Load dataset\n",
        "df = pd.read_csv(\"improved_resume_dataset.csv\")\n",
        "\n",
        "X = df[\"Resume_Text\"]\n",
        "y = df[\"Job_Category\"]\n",
        "\n",
        "# TF-IDF\n",
        "tfidf = TfidfVectorizer()\n",
        "X_tfidf = tfidf.fit_transform(X)\n",
        "\n",
        "# Train model\n",
        "model = LogisticRegression(max_iter=1000)\n",
        "model.fit(X_tfidf, y)\n",
        "\n",
        "print(\"Model Training Completed!\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "dRDSIc70rkrg",
        "outputId": "a99c9061-a856-44e5-c9af-4c3c3ac4a76f"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Model Training Completed!\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import pickle\n",
        "\n",
        "with open(\"resume_model.pkl\", \"wb\") as file:\n",
        "    pickle.dump(model, file)\n",
        "\n",
        "with open(\"tfidf.pkl\", \"wb\") as file:\n",
        "    pickle.dump(tfidf, file)\n",
        "\n",
        "print(\"Model and TF-IDF Saved Successfully!\")"
      ],
      "metadata": {
        "colab": {
