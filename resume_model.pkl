      "cell_type": "code",
      "source": [
        "# ==========================================\n",
        "# AI Resume Screening & Job Matching System\n",
        "# PART 4: RESUME PREDICTION & JOB MATCHING\n",
        "# ==========================================\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "# Function for predicting job role\n",
        "\n",
        "def predict_job(resume_text):\n",
        "\n",
        "    # Clean new resume\n",
        "    cleaned_resume = clean_resume(resume_text)\n",
        "\n",
        "    # Convert text using existing TF-IDF\n",
        "    resume_vector = tfidf.transform([cleaned_resume])\n",
        "\n",
        "    # Predict job category\n",
        "    prediction = model.predict(resume_vector)\n",
        "\n",
        "    # Get confidence score\n",
        "    probability = model.predict_proba(resume_vector)\n",
        "\n",
        "    score = np.max(probability) * 100\n",
        "\n",
        "    print(\"Resume Analysis Result\")\n",
        "    print(\"----------------------\")\n",
        "    print(\"Recommended Job Role :\", prediction[0])\n",
        "    print(\"Matching Score       :\", round(score, 2), \"%\")\n",
        "\n",
        "\n",
        "# Test Resume\n",
        "\n",
        "new_resume = \"\"\"\n",
        "Python Machine Learning SQL\n",
        "Data Analysis Pandas NumPy\n",
        "Deep Learning Artificial Intelligence\n",
        "\"\"\"\n",
        "\n",
        "predict_job(new_resume)"
      ],
