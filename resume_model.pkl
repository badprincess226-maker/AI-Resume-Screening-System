      "cell_type": "code",
      "source": [
        "# ==========================================\n",
        "# AI Resume Screening & Job Matching System\n",
        "# PART 2: DATA PREPROCESSING\n",
        "# ==========================================\n",
        "\n",
        "import pandas as pd\n",
        "import re\n",
        "\n",
        "# Load dataset\n",
        "df = pd.read_csv(\"resume_dataset.csv\")\n",
        "\n",
        "print(\"Dataset Loaded Successfully!\")\n",
        "print(df.head())\n",
        "\n",
        "\n",
        "# Function for cleaning resume text\n",
        "def clean_resume(text):\n",
        "    text = text.lower()  # Convert lowercase\n",
        "    text = re.sub(r'[^a-zA-Z ]', '', text)  # Remove symbols\n",
        "    text = re.sub(r'\\s+', ' ', text)  # Remove extra spaces\n",
        "    return text.strip()\n",
        "\n",
        "\n",
        "# Apply text cleaning\n",
        "df[\"Clean_Resume\"] = df[\"Resume_Text\"].apply(clean_resume)\n",
        "\n",
        "\n",
        "# Display cleaned resume\n",
        "print(\"\\nCleaned Resume Data:\")\n",
        "print(df[[\"Resume_Text\", \"Clean_Resume\"]].head())\n",
        "\n",
        "\n",
        "# Save processed dataset\n",
        "df.to_csv(\"processed_resume_dataset.csv\", index=False)\n",
        "\n",
        "print(\"\\nPart 2 Completed Successfully!\")\n",
        "print(\"Processed file created: processed_resume_dataset.csv\")"
      ],
      "metadata": {
