    {
      "cell_type": "code",
      "source": [
        "# ==========================================\n",
        "# PART 10: FINAL RESUME SCREENING TEST\n",
        "# ==========================================\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "def predict_resume(resume_text):\n",
        "\n",
        "    # Convert resume text to vector\n",
        "    resume_vector = tfidf.transform([resume_text])\n",
        "\n",
        "    # Predict job role\n",
        "    prediction = model.predict(resume_vector)\n",
        "\n",
        "    # Get confidence score\n",
        "    score = np.max(model.predict_proba(resume_vector)) * 100\n",
        "\n",
        "    print(\"================================\")\n",
        "    print(\" AI Resume Screening Result \")\n",
        "    print(\"================================\")\n",
        "\n",
        "    print(\"Recommended Job Role :\", prediction[0])\n",
        "    print(\"Matching Score       :\", round(score, 2), \"%\")\n",
        "\n",
        "\n",
        "# Test Candidate Resume\n",
        "\n",
        "candidate_resume = \"\"\"\n",
        "Python Machine Learning\n",
        "Deep Learning SQL\n",
        "Data Analysis Pandas NumPy\n",
        "Artificial Intelligence Projects\n",
        "\"\"\"\n",
        "\n",
        "predict_resume(candidate_resume)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "-LL54-3zn4nh",
        "outputId": "24a31634-d69b-4210-b1f1-6d7fc5b495dc"
