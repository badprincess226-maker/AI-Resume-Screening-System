      "cell_type": "code",
      "source": [
        "%%writefile app.py\n",
        "\n",
        "import streamlit as st\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import pickle\n",
        "\n",
        "\n",
        "# Load Model\n",
        "model = pickle.load(open(\"resume_model.pkl\",\"rb\"))\n",
        "tfidf = pickle.load(open(\"tfidf.pkl\",\"rb\"))\n",
        "\n",
        "\n",
        "def clean_resume(text):\n",
        "    text = text.lower()\n",
        "    return text\n",
        "\n",
        "\n",
        "st.title(\"AI Resume Screening & Job Matching System\")\n",
        "\n",
        "st.write(\"Upload your resume text and get suitable job recommendations\")\n",
        "\n",
        "\n",
        "resume = st.text_area(\n",
        "    \"Enter Resume Details\"\n",
        ")\n",
        "\n",
        "\n",
        "if st.button(\"Analyze Resume\"):\n",
        "\n",
        "    cleaned_text = clean_resume(resume)\n",
        "\n",
        "    vector = tfidf.transform([cleaned_text])\n",
        "\n",
        "    prediction = model.predict(vector)\n",
        "\n",
        "    score = np.max(model.predict_proba(vector))*100\n",
        "\n",
        "\n",
        "    st.success(\"Analysis Completed!\")\n",
        "\n",
        "    st.write(\"### Recommended Job Role:\")\n",
        "    st.write(prediction[0])\n",
        "\n",
        "    st.write(\"### Matching Score:\")\n",
        "    st.write(str(round(score,2))+\" %\")"
      ],
      "metadata": {
        "colab": {
